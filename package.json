{
  "name": "mbtiles-stacker",
  "description": "Map tile composer.",
  "version": "1.5.3",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "coveralls-next": "^6.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^4.3.8",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2"
  },
  "scripts": {
    "start": "micro",
    "debug": "nodemon --inspect-brk --inspect=0.0.0.0:9229 index.js --port 8000",
    "commit": "npx git-cz",
    "report-coverage": "coveralls-next < coverage/lcov.info"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "jimp": "^0.22.12",
    "log-less-fancy": "^1.4.0",
    "micro": "^10.0.1",
    "node-fetch": "^2.7.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Artsdatabanken/mbtiles-stacker.git"
  },
  "keywords": [
    "mbtiles",
    "raster-tiles",
    "vector-tiles"
  ],
  "author": "Bjorn Reppen <bjreppen@gmail.com> (https://github.com/bjornreppen)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Artsdatabanken/mbtiles-stacker/issues"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.{js,jsx}",
      "!**/node_modules/**"
    ],
    "coverageReporters": [
      "lcov"
    ]
  },
  "homepage": "https://github.com/Artsdatabanken/mbtiles-stacker#readme"
}
